{
	email {$ACME_EMAIL}
}

{$MOCKINGO_GATEWAY_HOST}, *.{$MOCKINGO_BASE_DOMAIN} {
	tls {
		dns route53 {
			wait_for_route53_sync true
			route53_max_wait 2m
		}
	}

	@metrics path /metrics
	respond @metrics 404

	# Caddy preserves WebSocket upgrade headers. Token authentication remains
	# mandatory for /internal/* even if a firewall also restricts this host.
	reverse_proxy mockingo-gateway:9090 {
		header_up Host {host}
	}
}
