FROM golang:1.25.7-alpine3.23 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/mockingo-gateway ./cmd/mockingo-gateway

FROM alpine:3.23.4
RUN addgroup -S -g 65532 mockingo && adduser -S -D -H -u 65532 -G mockingo mockingo
COPY --from=build /out/mockingo-gateway /usr/local/bin/mockingo-gateway
USER 65532:65532
EXPOSE 9090
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 CMD ["mockingo-gateway", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/mockingo-gateway"]
CMD ["serve"]
