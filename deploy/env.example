MOCKINGO_ENV=production

MOCKINGO_BASE_DOMAIN=mockingo.click
MOCKINGO_GATEWAY_HOST=gateway.mockingo.com
MOCKINGO_PUBLIC_SCHEME=https

MOCKINGO_BACKEND_URL=https://api.mockingo.com
MOCKINGO_BACKEND_JWKS_URL=https://api.mockingo.com/.well-known/mockingo-tunnel-jwks.json
MOCKINGO_TUNNEL_TICKET_ISSUER=https://api.mockingo.com
MOCKINGO_TUNNEL_TICKET_AUDIENCE=mockingo-gateway
MOCKINGO_TUNNEL_PROTOCOL_VERSION=1
MOCKINGO_BACKEND_CALLBACK_TOKEN=replace-with-the-backend-gateway-callback-token
MOCKINGO_GATEWAY_INTERNAL_TOKEN=replace-with-the-backend-to-gateway-internal-token
MOCKINGO_GATEWAY_INSTANCE_ID=gateway-1
MOCKINGO_JWKS_REFRESH_INTERVAL=15m
MOCKINGO_JWKS_HTTP_TIMEOUT=5s
MOCKINGO_BACKEND_CALLBACK_TIMEOUT=5s
MOCKINGO_BACKEND_CALLBACK_ATTEMPTS=3
MOCKINGO_BACKEND_CALLBACK_BACKOFF=100ms
MOCKINGO_TICKET_CLOCK_SKEW=5s
MOCKINGO_REPLAY_CACHE_MAX_ENTRIES=100000
MOCKINGO_INTERNAL_STATUS_MAX_BATCH=500

DATABASE_URL=postgres://mockingo_gateway_reader:replace-reader-password@postgres.example.internal:5432/mockingo?sslmode=require

ACME_EMAIL=admin@example.com
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MOCKINGO_TRUSTED_PROXY_CIDRS=172.16.0.0/12
MOCKINGO_LOG_LEVEL=info
MOCKINGO_METRICS_ENABLED=true
