MOCKINGO_ENV=production

MOCKINGO_BASE_DOMAIN=mockingo.click
MOCKINGO_PUBLIC_SCHEME=https
MOCKINGO_API_PUBLIC_URL=https://api.mockingo.click
MOCKINGO_API_TOKEN=replace-with-a-long-random-secret-at-least-32-characters

DATABASE_URL=postgres://mockingo:replace-password@postgres:5432/mockingo?sslmode=disable
POSTGRES_DB=mockingo
POSTGRES_USER=mockingo
POSTGRES_PASSWORD=replace-password

ACME_EMAIL=admin@example.com
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MOCKINGO_TRUSTED_PROXY_CIDRS=172.16.0.0/12
MOCKINGO_LOG_LEVEL=info
